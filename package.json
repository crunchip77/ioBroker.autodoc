{
  "name": "iobroker.autodoc",
  "version": "0.9.39-alpha.0",
  "description": "On-demand documentation for ioBroker",
  "author": {
    "name": "crunchip77",
    "email": "41550245+crunchip77@users.noreply.github.com"
  },
  "contributors": [
    {
      "name": "crunchip77"
    }
  ],
  "homepage": "https://github.com/crunchip77/ioBroker.autodoc/blob/main/README.md",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "doc",
    "documentation",
    "analysis",
    "mermaid",
    "pdf"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/crunchip77/ioBroker.autodoc.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "overrides": {
    "chromium-bidi": {
      "devtools-protocol": "0.0.1107588"
    }
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.3.2",
    "markdown-it": "^14.1.0",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "@mermaid-js/mermaid-cli": "10.9.1",
    "puppeteer": "^19.0.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.1.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.1.2",
    "@alcalzone/release-script-plugin-license": "^5.1.1",
    "@alcalzone/release-script-plugin-manual-review": "^5.1.1",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.2.0",
    "@iobroker/testing": "^5.2.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/iobroker": "npm:@iobroker/types@^7.1.0",
    "@types/node": "^25.5.0",
    "cytoscape": "^3.33.3",
    "d3-selection": "^3.0.0",
    "devtools-protocol": "^0.0.1107588",
    "typescript": "~6.0.2"
  },
  "main": "main.js",
  "files": [
    "LICENSE",
    "io-package.json",
    "main.js",
    "lib/",
    "www/",
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup).js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint -c eslint.config.mjs .",
    "adapter-check": "npx --yes @iobroker/repochecker@5.11.1 \"https://github.com/crunchip77/ioBroker.autodoc\" main --local",
    "i18n:sync-mermaid-help": "node scripts/sync-mermaid-help-i18n-key.js",
    "translate": "translate-adapter",
    "release": "release-script",
    "dev-server": "dev-server"
  },
  "bugs": {
    "url": "https://github.com/crunchip77/ioBroker.autodoc/issues"
  },
  "readmeFilename": "README.md"
}

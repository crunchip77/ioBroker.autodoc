// Specialized tsconfig for type-checking js files
{
	"extends": "./tsconfig.json",
	"compilerOptions": {},
	"include": ["**/*.js", "**/*.d.ts"],
	"exclude": [
		"**/build",
		"node_modules/",
		"widgets/",
		"iobroker-data/**",
		"install/**",
		"controller.js",
		"install.js",
		"uninstall.js"
	]
}
